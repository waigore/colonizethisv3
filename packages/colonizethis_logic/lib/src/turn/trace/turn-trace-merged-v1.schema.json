{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colonizethis.dev/schemas/turn-trace-merged-v1.schema.json",
  "title": "ColonizeThis Merged Turn Trace V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "meta",
    "ai",
    "turnResolution"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gameId",
        "turnNumber",
        "capturedAtUtc"
      ],
      "properties": {
        "gameId": {
          "type": "string",
          "minLength": 1
        },
        "turnNumber": {
          "type": "integer",
          "minimum": 1
        },
        "capturedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ai": {
      "type": "array",
      "items": {
        "$ref": "turn-trace-ai-v1.schema.json"
      }
    },
    "turnResolution": {
      "$ref": "turn-trace-resolution-v1.schema.json"
    }
  }
}
